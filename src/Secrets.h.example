// Copy this file to src/Secrets.h (gitignored) and fill in the values.
//
// Why a header and not -D flags: PlatformIO splits build_flags with a
// shell-like parser, and that parser cannot carry a space. Writing
// -DSECRET_WIFI_SSID=\"has space\" splits into two tokens and the build dies
// with a missing terminating quote; backslash escapes are consumed before the
// compiler sees them, so \040 arrives as the literal text 040. The INI layer
// truncates any value containing # or ; as an inline comment. A header has none
// of those failure modes.
//
// Do NOT wrap this in a namespace: NetworkConfig.h includes it from inside
// namespace NetworkConfig.
//
// Leave a value empty to mean "not configured": the firmware then logs once and
// stays inert instead of retrying.
//
// Where the values come from: docs/REMOTE_ACCESS.md section 6.4.
#pragma once

#define SECRET_WIFI_SSID "your-2.4GHz-ssid"
#define SECRET_WIFI_PASS "your-wifi-password"
#define SECRET_SERVER_URL "https://server-address/api/v1/telemetry"
#define SECRET_SERVER_WS_URL "wss://server-address/api/v1/device-stream"
#define SECRET_DEVICE_ID "incubator-001"
#define SECRET_DEVICE_TOKEN "64-hex-token-from-devices.json"
