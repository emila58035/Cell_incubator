# Copy to /etc/incubator-camera/camera.env and fill in the camera-001 token.
# Use absolute paths. Keep values literal (no $HOME or shell commands).
INCUBATOR_CAMERA_SERVER=https://175.24.182.190
INCUBATOR_CAMERA_TOKEN=REPLACE_WITH_CAMERA_001_TOKEN
INCUBATOR_CAMERA_CA=/etc/incubator-camera/incubator-ca.pem
INCUBATOR_CAMERA_DEVICE=0
INCUBATOR_CAMERA_TEMP_DIR=/var/lib/incubator-camera/tmp
